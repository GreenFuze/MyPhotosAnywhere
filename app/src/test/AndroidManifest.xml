<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- Host tests merge an already processed app manifest. Keep manual WorkManager
             initialization explicit without repeating the production removal marker. -->
        <provider android:name="androidx.startup.InitializationProvider" android:authorities="${applicationId}.androidx-startup" android:exported="false" tools:node="merge">
            <meta-data android:name="androidx.work.WorkManagerInitializer" android:value="mpa.manual-initialization" tools:node="merge" tools:replace="android:value" />
        </provider>
    </application>
</manifest>
