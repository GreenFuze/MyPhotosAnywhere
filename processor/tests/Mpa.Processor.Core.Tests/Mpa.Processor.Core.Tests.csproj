<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Mpa.Processor.TestWorkerHost/TestProcessIdentity.cs" Link="TestProcessIdentity.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="[18.11.0]" />
    <PackageReference Include="MSTest.TestFramework" Version="[4.5.1]" />
    <PackageReference Include="MSTest.TestAdapter" Version="[4.5.1]" />
    <ProjectReference Include="../../src/Mpa.Processor.Core/Mpa.Processor.Core.csproj" />
    <ProjectReference Include="../Mpa.Processor.TestWorkerHost/Mpa.Processor.TestWorkerHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopySyntheticWorkerFixture" AfterTargets="Build">
    <ItemGroup><WorkerFixtureFiles Include="../Mpa.Processor.TestWorkerHost/bin/$(Configuration)/net10.0/**/*" /></ItemGroup>
    <Copy SourceFiles="@(WorkerFixtureFiles)" DestinationFiles="@(WorkerFixtureFiles->'$(OutDir)WorkerFixture/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
